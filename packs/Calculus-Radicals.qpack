QPACK/1
{
  "id": "commonstudy-calculus-radicals",
  "title": "Radicals for calculus",
  "source": "CommonStudy · Calculus",
  "sets": [
    {
      "id": "commonstudy-calculus-radicals-set",
      "title": "Radicals for calculus",
      "section": "Calculus",
      "timeLimitMinutes": 20,
      "questions": [
        {
          "id": "commonstudy-calculus-radicals-q1",
          "number": 1,
          "prompt": "Simplify √(x²) for real x.",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "|x|"
            },
            {
              "id": "B",
              "text": "x"
            },
            {
              "id": "C",
              "text": "−x"
            },
            {
              "id": "D",
              "text": "x²"
            }
          ],
          "correctChoiceID": "A",
          "explanation": "The principal square root is nonnegative, so √(x²) = |x|."
        },
        {
          "id": "commonstudy-calculus-radicals-q2",
          "number": 2,
          "prompt": "Rewrite 1/∛(x²) as a power, for x > 0.",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "x^(2/3)"
            },
            {
              "id": "B",
              "text": "x^(−2/3)"
            },
            {
              "id": "C",
              "text": "x^(−3/2)"
            },
            {
              "id": "D",
              "text": "x^(−1/3)"
            }
          ],
          "correctChoiceID": "B",
          "explanation": "A cube root is a power of 1/3; the reciprocal negates the exponent."
        },
        {
          "id": "commonstudy-calculus-radicals-q3",
          "number": 3,
          "prompt": "d/dx √x, x > 0",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "√x/2"
            },
            {
              "id": "B",
              "text": "2√x"
            },
            {
              "id": "C",
              "text": "1/(2√x)"
            },
            {
              "id": "D",
              "text": "−1/(2√x)"
            }
          ],
          "correctChoiceID": "C",
          "explanation": "Rewrite √x as x^(1/2), then use the power rule."
        },
        {
          "id": "commonstudy-calculus-radicals-q4",
          "number": 4,
          "prompt": "d/dx √(3x + 1), x > −1/3",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "1/(2√(3x + 1))"
            },
            {
              "id": "B",
              "text": "3√(3x + 1)/2"
            },
            {
              "id": "C",
              "text": "−3/(2√(3x + 1))"
            },
            {
              "id": "D",
              "text": "3/(2√(3x + 1))"
            }
          ],
          "correctChoiceID": "D",
          "explanation": "The chain rule contributes the inner derivative 3."
        },
        {
          "id": "commonstudy-calculus-radicals-q5",
          "number": 5,
          "prompt": "d/dx ∛x, x ≠ 0",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "1/(3x^(2/3))"
            },
            {
              "id": "B",
              "text": "1/(3x^(1/3))"
            },
            {
              "id": "C",
              "text": "3x^(2/3)"
            },
            {
              "id": "D",
              "text": "−1/(3x^(2/3))"
            }
          ],
          "correctChoiceID": "A",
          "explanation": "Use d/dx x^(1/3) = (1/3)x^(−2/3). No finite derivative exists at zero."
        },
        {
          "id": "commonstudy-calculus-radicals-q6",
          "number": 6,
          "prompt": "d/dx [x√x], x > 0",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "(1/2)√x"
            },
            {
              "id": "B",
              "text": "(3/2)√x"
            },
            {
              "id": "C",
              "text": "3/(2√x)"
            },
            {
              "id": "D",
              "text": "2√x"
            }
          ],
          "correctChoiceID": "B",
          "explanation": "x√x = x^(3/2), whose derivative is (3/2)x^(1/2)."
        },
        {
          "id": "commonstudy-calculus-radicals-q7",
          "number": 7,
          "prompt": "Evaluate lim as x → 0 of (√(1 + x) − 1)/x.",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "0"
            },
            {
              "id": "B",
              "text": "1"
            },
            {
              "id": "C",
              "text": "1/2"
            },
            {
              "id": "D",
              "text": "Does not exist"
            }
          ],
          "correctChoiceID": "C",
          "explanation": "Multiply by the conjugate to get 1/(√(1 + x) + 1), then substitute x = 0."
        },
        {
          "id": "commonstudy-calculus-radicals-q8",
          "number": 8,
          "prompt": "Evaluate lim as x → 4 of (√x − 2)/(x − 4).",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "1/2"
            },
            {
              "id": "B",
              "text": "0"
            },
            {
              "id": "C",
              "text": "4"
            },
            {
              "id": "D",
              "text": "1/4"
            }
          ],
          "correctChoiceID": "D",
          "explanation": "Rationalization gives 1/(√x + 2). At x = 4 the denominator is 4."
        },
        {
          "id": "commonstudy-calculus-radicals-q9",
          "number": 9,
          "prompt": "Find ∫ 1/√x dx for x > 0.",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "2√x + C"
            },
            {
              "id": "B",
              "text": "√x/2 + C"
            },
            {
              "id": "C",
              "text": "ln(x) + C"
            },
            {
              "id": "D",
              "text": "−2/√x + C"
            }
          ],
          "correctChoiceID": "A",
          "explanation": "Integrate x^(−1/2): raise the exponent to 1/2 and divide by 1/2."
        },
        {
          "id": "commonstudy-calculus-radicals-q10",
          "number": 10,
          "prompt": "Find the tangent line to y = √x at x = 4.",
          "passage": "Use radians for trigonometric functions. Assume real variables and work where the expression is defined. Select the correct answer.",
          "choices": [
            {
              "id": "A",
              "text": "y = 2 + (x − 4)/2"
            },
            {
              "id": "B",
              "text": "y = 2 + (x − 4)/4"
            },
            {
              "id": "C",
              "text": "y = 4 + (x − 2)/4"
            },
            {
              "id": "D",
              "text": "y = 2 − (x − 4)/4"
            }
          ],
          "correctChoiceID": "B",
          "explanation": "The point is (4, 2) and the slope is 1/(2√4) = 1/4."
        }
      ]
    }
  ]
}

